# Ta clé API Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Où recevoir les verdicts (facultatif : sans ça, ils sont écrits dans les logs)
TELEGRAM_TOKEN=123456789:AA...
